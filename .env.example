VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:5100

# Sign-in. Production builds always use Firebase (same project as slr-be and the writing backend).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# Set to false to hide the Google button (the emulator and email/password sign-in keep working).
# VITE_FIREBASE_GOOGLE_SIGN_IN=true
# Development with the Firebase Auth emulator (slr-be's `npm run emulators`): use the emulator's project id
# (slr-system-dev), any API key, and point the app at it. Never honoured in a production build.
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
# Development only: `dev` skips sign-in and relies on the backend's DEV_AUTH_ENABLED (with VITE_DEV_AUTH_UID below).
# Without Firebase config this is the default in development; set `firebase` to force the real flow.
# VITE_AUTH_MODE=dev

# Optional, local development only. Identifies this UID to the writing backend; it is not an SLR bearer token.
# VITE_DEV_AUTH_UID=dev_user

