{
  "name": "slr-ai-writing-fe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:ui-visual": "node scripts/capture-live-ui.cjs",
    "demo:walkthrough": "node scripts/live-demo-walkthrough.cjs",
    "export:pdf": "node ../slr-writing-be/scripts/generate-paper-pdf.cjs --profile=all",
    "export:pdf:ieee": "node ../slr-writing-be/scripts/generate-paper-pdf.cjs --profile=ieee",
    "export:pdf:imrad": "node ../slr-writing-be/scripts/generate-paper-pdf.cjs --profile=imrad",
    "start:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ../slr-writing-be/scripts/start-dev.ps1",
    "stop:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ../slr-writing-be/scripts/stop-dev.ps1"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "gsap": "^3.13.0",
    "i18next": "^26.5.12",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.1.9",
    "react-router": "^7.9.4",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.16",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
